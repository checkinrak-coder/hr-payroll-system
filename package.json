{
  "name": "orbit-hr-desktop",
  "version": "1.0.0",
  "description": "Orbit HR - Desktop HR and Payroll Management System",
  "main": "public/electron.js",
  "homepage": "./",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:next\" \"wait-on http://localhost:3000 && npm run dev:electron\"",
    "dev:next": "next dev",
    "dev:electron": "electron public/electron.js",
    "build": "next build && npm run build:electron",
    "build:electron": "electron-builder",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "lucide-react": "^0.468.0",
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "better-sqlite3": "^9.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.5",
    "prisma": "^5.19.1",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "wait-on": "^7.2.0"
  }
}
